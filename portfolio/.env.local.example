# Copy this file to .env.local and fill in the real value.
# .env.local is gitignored and must never be committed.

# Base URL of the Azure Function App backing the contact form,
# e.g. https://your-func-app.azurewebsites.net
NEXT_PUBLIC_CONTACT_API_URL=

# Full URL of the nowplaying Azure Function endpoint, e.g.
# https://your-func-app.azurewebsites.net/api/nowplaying
NEXT_PUBLIC_NOWPLAYING_API_URL=
